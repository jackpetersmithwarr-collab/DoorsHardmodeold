local damaged = false

---====== Load spawner ======---

local Spawner = loadstring(game:HttpGet("https://raw.githubusercontent.com/RegularVynixu/DOORS-Entity-Spawner-V2/main/init.luau"))()

---====== Create entity ======---

local entity = Spawner:Create({
	Entity = {
		Name = "Cease",
		Asset = "rbxassetid://11535799840",
		HeightOffset = 0
	},
	Lights = {
		Flicker = {
			Enabled = false,
			Duration = 1
		},
		Shatter = false,
		Repair = false
	},
	Earthquake = {
		Enabled = false
	},
	CameraShake = {
		Enabled = true,
		Range = 100,
		Values = {10, 10, 0.1, 1} -- Magnitude, Roughness, FadeIn, FadeOut
	},
	Movement = {
		Speed = 100,
		Delay = 3,
		Reversed = false
	},
	Rebounding = {
		Enabled = false,
		Type = "Ambush", -- "Blitz"
		Min = 1,
		Max = 1,
		Delay = 2
	},
	Damage = {
		Enabled = false,
		IgnoreHiding = false,
		Range = 40,
		Amount = 125
	},
	Crucifixion = {
        Type = "Guiding",
		Enabled = true,
		Range = 40,
		Resist = false,
		Break = true
	},
	Death = {
		Type = "Guiding", -- "Curious"
		Hints = {"You die to cease", "When lights turn blue don’t move", "Moving angers it", "Bye"},
		Cause = "Cease"
	}
})

---====== Debug entity ======---

entity:SetCallback("OnSpawned", function()
    print("Entity has spawned")

local Lighting = game:GetService("Lighting")
local TweenService = game:GetService("TweenService")

local FADE_OUT_DELAY = 15
local FADE_TIME = 4

local colorCorrection = Instance.new("ColorCorrectionEffect")
colorCorrection.TintColor = Color3.fromRGB(0, 55, 255)
colorCorrection.Brightness = -0.2
colorCorrection.Saturation = -0.2
colorCorrection.Parent = Lighting

local sound = Instance.new("Sound")
sound.SoundId = "rbxassetid://4398878054"
sound.Volume = 1
sound.PlayOnRemove = true
sound.Parent = Lighting
sound:Destroy()

task.wait(FADE_OUT_DELAY)

local tweenInfo = TweenInfo.new(FADE_TIME, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
local targetProperties = {
	TintColor = Color3.fromRGB(255, 255, 255),
	Brightness = 0,
	Saturation = 0
}

local fadeTween = TweenService:Create(colorCorrection, tweenInfo, targetProperties)
fadeTween:Play()

fadeTween.Completed:Connect(function()
	colorCorrection:Destroy()
end)

end)

entity:SetCallback("OnStartMoving", function()
    while task.wait() and damaged == false do
        if game.Players.LocalPlayer.Character.Humanoid.MoveDirection.Magnitude > 0 then
            damaged = true
            game.Players.LocalPlayer.Character.Humanoid.Health = 0
        end
    end
end)

entity:SetCallback("OnEnterRoom", function(room: Model, firstTime: boolean)
    if firstTime == true then
        print("Entity has entered room: ".. room.Name.. " for the first time")
    else
        print("Entity has entered room: ".. room.Name.. " again")
    end
end)

entity:SetCallback("OnLookAt", function(lineOfSight: boolean)
	if lineOfSight == true then
		print("Player is looking at entity")
	else
		print("Player view is obstructed by something")
	end
end)

entity:SetCallback("OnRebounding", function(startOfRebound: boolean)
    if startOfRebound == true then
        print("Entity has started rebounding")
	else
        print("Entity has finished rebounding")
	end
end)

entity:SetCallback("OnDespawning", function()
    damaged = true
end)

entity:SetCallback("OnDespawned", function()
    print("Entity has despawned")
end)

entity:SetCallback("OnDamagePlayer", function(newHealth: number)
	if newHealth <= 0 then
		print("Entity has killed the player")
	else
		print("Entity has damaged the player")
	end
end)

